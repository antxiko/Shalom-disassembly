# Notas del banco 04

# --- A MANO: comentarios, nombres y bloques ---
C 0x6019 el actor 1 (0xE480 + 0x1B)
C 0x6020 el actor 2
C 0x6027 el actor 3
C 0x602E el actor 4
C 0x6035 bien: 1
C 0x65D4 el byte del RLE
C 0x65D6 0: acaba
C 0x65D9 bit 7: repetir
C 0x65DF 0x80: otra direccion
C 0x65E1 C = cuantos se copian
C 0x6619 la cuenta baja
C 0x661B hasta 0x0E
C 0x661F par: patrones; impar: colores
C 0x6624 la fila (nibble alto) por 64
C 0x662C y la columna (nibble bajo) / 2
C 0x6639 el destino de la lista
C 0x664B la columna
C 0x664E la 0x0F pasa a la fila siguiente
C 0x6656 la columna / 2
C 0x665A en la tabla p04:6683
C 0x666E en los colores (0x800 mas alla)
C 0x6673 el destino de la lista
C 0x6797 la ficha
C 0x6798 la siguiente
C 0x679E la siguiente fila
C 0x6949 una ficha del dibujo
C 0x6951 la siguiente fila (0x20)
C 0x6A15 DE = el destino
C 0x6A19 C = cuantos
C 0x6A1D se copian
C 0x6C16 cuantas veces se eligio
C 0x6C1B la primera vez, el texto 0x1C; luego el 0x1D
C 0x6DAF cuantas veces se eligio
C 0x6DB4 la primera vez, el texto 0x27; luego el 0x2A
C 0x6DCE cuantas veces se eligio
C 0x6DD3 la primera vez, el texto 0x28; luego el 0x29
C 0x6EF7 DE = la fila de fichas
C 0x6EFB B = cuantas
C 0x6EFD HL = su VRAM

