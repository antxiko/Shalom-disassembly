L 0xBAF1 sonido_15 pide el sonido 0x15
L 0xBAF6 sonido_5d pide el sonido 0x5D
L 0xBAFB sonido_5e pide el sonido 0x5E
L 0xBB00 sonido_3b pide el sonido 0x3B
L 0xBB05 sonido_32 pide el sonido 0x32
L 0xBB0A sonido_3f pide el sonido 0x3F
L 0xBB0F sonido_42 pide el sonido 0x42
L 0xBB14 graba_en_el_otro_cartucho un paso de la grabacion en el otro cartucho (0xE38E, tabla p03:BB1A)
L 0xBB20 graba_siguiente 0xE38E + 1
L 0xBB5F comprueba_el_otro_cartucho un paso de la comprobacion: lo vuelve a leer y lo compara con 0xEB40 (tabla p03:BB65)
L 0xBBB4 graba_en_disco un paso de la grabacion en disco (tabla p03:BBBA)
L 0xBBFF comprueba_el_disco un paso de la comprobacion del disco (tabla p03:BC05)
L 0xBC54 disco_escribe BDOS: crea el fichero de p03:BC85, escribe los 0x3E bytes de la partida y lo cierra
L 0xBC90 disco_lee BDOS: abre el fichero de p03:BC85 y lee los 0x3E bytes a 0xE03A
L 0xBCBE bdos_abre BDOS 0x0F (abrir) con el FCB de 0xE035
L 0xBCCE bdos_crea BDOS 0x16 (crear)
L 0xBCDE bdos_cierra BDOS 0x10 (cerrar)
L 0xBCEE prepara_fcb el FCB en DE: unidad 0, el nombre de HL y ceros
L 0xBD05 fcb_registro bloque actual 0, registro de 1 byte y registro aleatorio 0
L 0xBD22 bdos_escribe DTA = 0xC8C0 y 0x3E bytes con BDOS 0x26
L 0xBD30 bdos_lee DTA = 0xE03A y 0x3E bytes con BDOS 0x27
L 0xBD3E bdos_escribe_bloque BDOS 0x26 (escribir bloque); error 4
L 0xBD4E bdos_lee_bloque BDOS 0x27 (leer bloque); error 3
L 0xBD6D disco_mal error: recupera la pila y H.KEYI y 0xE38F = 2
L 0xBD80 cambia_ram_del_disco cambia 0xC000-0xD0FF por la copia de 0xE280 y borra 0xF1C0
L 0xBD8A espera_y_devuelve_ram 256 llamadas a 0xCE7B y vuelve a cambiar la RAM
L 0xBD97 intercambia_ram intercambia 0x1100 bytes de 0xE280 con 0xC000
L 0xBDAF graba_en_cinta un paso de la grabacion en cinta (tabla p03:BDB5)
L 0xBDBD cinta_siguiente 0xE38E + 1
L 0xBDDA cinta_escribe_cabecera 10 x 0xEA y el nombre de p03:BE03
L 0xBE09 cinta_escribe_partida los 0x3E bytes de 0xEB40 y la suma
L 0xBE3F suma_de_la_partida A = la suma de los 0x3F bytes de 0xEB40
L 0xBE4B guarda_nombres los nombres 0xEB00/0xEB09 a la partida (0xEB42/0xEB4A)
L 0xBE5A copia_hasta_ff copia de HL a DE hasta 0xFF
L 0xBE63 guarda_objetos el bit 0 de cada objeto de 0xE9D0 a los bits de 0xEB53-0xEB55
L 0xBE86 cinta_mal_al_grabar para el motor y 0xE38F = 2
L 0xBE98 aviso_de_grabar el nombre y el aviso de p03:BEC5
L 0xBEA4 nombre_a_vram el nombre de 0xEB1B a la VRAM 0x3A21
L 0xBEE1 comprueba_la_cinta un paso de la comprobacion de la cinta (tabla p03:BEE7)
L 0xBEF9 cinta_compara lee la cinta y la compara con 0xEB40 y la suma
L 0xBF43 cinta_busca_cabecera busca 10 x 0xEA y el nombre de p03:BE03
L 0xBF71 aviso_de_comprobar el nombre y el aviso de p03:BF7D
