# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x8C56 prepara_escena un paso de la preparacion de la escena de accion (0xE39F, tabla p10:8C5C)
L 0x8C60 monta_escena sprites y proyectiles a cero, la pantalla, el rival (p10:8D00), su sonido y los graficos de 27-28
L 0x8CAC mueve_objetos un cuadro de los 8 objetos de 0xEA00 (0x20 bytes): la rutina de su clase
L 0x8CC3 rutina_del_objeto cuenta un cuadro y salta a la rutina de la clase (ix+0) (tabla p10:8CCD)
L 0x8D00 crea_rival borra 0xE400-0xE7FF y 0xEA00-0xEAFF y pone en 0xEA00 el de la escena 0xE3A1 (p10:8D6F: Y, X, nombre...)
L 0x8DD8 objeto_01 la clase 1 de los objetos de 0xEA00 (p10:8CCD): un paso (ix+1) de la tabla p10:8DDE
L 0x8DF8 objeto_01_0 la clase 1, paso 0
L 0x8E08 objeto_01_1 la clase 1, paso 1
L 0x8E0D objeto_01_2 la clase 1, paso 2
L 0x8E31 dibujo_a_ram [n] n bytes [salto] hasta 0xFF, de DE a HL (sin pasar de 0xEEA0)
L 0x8E56 objeto_01_3 la clase 1, paso 3
L 0x8E5B objeto_01_4 la clase 1, paso 4
L 0x8E75 objeto_01_5 la clase 1, paso 5
L 0x8E7A objeto_01_6 la clase 1, paso 6
L 0x8E8A objeto_01_7 la clase 1, paso 7
L 0x8EB3 objeto_01_8 la clase 1, paso 8
L 0x8EC6 objeto_01_9 la clase 1, paso 9
L 0x8EDE restaura_marco 0x40 bytes de p10:8EEA a 0xEEA0
L 0x90E6 objeto_02 la clase 2 de los objetos de 0xEA00 (p10:8CCD): un paso (ix+1) de la tabla p10:90EC
L 0x9100 objeto_02_0 la clase 2, paso 0
L 0x9118 objeto_02_1 la clase 2, paso 1
L 0x9120 objeto_02_2 la clase 2, paso 2
L 0x913A dibujo_con_destino [destino] y el dibujo de DE (p10:9140) y vuelca los nombres
L 0x9157 objeto_02_3 la clase 2, paso 3
L 0x9163 objeto_02_4 la clase 2, paso 4
L 0x918F objeto_02_5 la clase 2, paso 5
