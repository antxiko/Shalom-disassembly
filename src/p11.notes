# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0xA0CC objeto_19 la rutina de la clase 19 de los objetos de 0xEA00 (p10:8CCD)
L 0xA0DB objeto_20 la rutina de la clase 20 de los objetos de 0xEA00 (p10:8CCD)
L 0xA0EA objeto_21 la rutina de la clase 21 de los objetos de 0xEA00 (p10:8CCD)
L 0xA154 objeto_fuera si el objeto sale por la izquierda o por abajo, lo borra y no vuelve a su rutina
L 0xA165 objeto_parado el objeto con fotograma 1, choques 2 y velocidad X -8
L 0xA17F objeto_08 la rutina de la clase 8 de los objetos de 0xEA00 (p10:8CCD)
L 0xA244 jefe_8_vencido pone el bit 0 de 0xEB7D y salta a la sala 0x12C
L 0xA264 dibujo_de_15_filas 15 filas de p11:A352 a 0xED00: [salto] y bytes hasta 0xFF
L 0xA27E copia_hasta_ff copia de HL a DE hasta 0xFF
L 0xA287 piezas_del_jefe las 10 piezas de 0xEC60 (dibujos p11:A2F6) en la pantalla, o borradas
L 0xA2D9 pieza un dibujo [alto][ancho] y sus fichas a DE (o ceros con (ix+0x10))
L 0xA47A objeto_09 la rutina de la clase 9 de los objetos de 0xEA00 (p10:8CCD)
L 0xA4BD sprites_que_bajan los 5 sprites de 0xF060 bajan uno; NZ si queda alguno
L 0xA4D4 esconde_cinco_sprites los 5 sprites de 0xF060 escondidos
L 0xA4E3 pon_cinco_sprites los 5 sprites de p11:A4EF en 0xF060
L 0xA503 parpadeo_de_cinco_sprites el color de los 5 sprites de 0xF060 segun el cuadro (p11:A522)
L 0xA610 destello el color del borde alterna 0x0F y 0x00 (VDP R#7)
L 0xA619 borde_negro el color del borde a 0xE0
L 0xA64C objeto_24 la rutina de la clase 24 de los objetos de 0xEA00 (p10:8CCD)
L 0xA6CB objeto_25 la rutina de la clase 25 de los objetos de 0xEA00 (p10:8CCD)
L 0xA718 choques_de_la_escena los choques de los 8 objetos de 0xEA00 con el personaje (bit 0 de +0x0D) y con los proyectiles (bit 1)
L 0xA747 choque_con_el_personaje si el objeto toca al personaje (medidas p11:A7ED): su rutina (p11:A785); tras un golpe, 0x40 o 0x20 cuadros sin dano
L 0xA819 choque_con_los_proyectiles mira los 3 proyectiles de 0xEC30 contra el objeto
L 0xA82F choque_con_un_proyectil si el proyectil DE toca al objeto (medidas p11:A96F): su rutina (p11:A867)
L 0xA99B lanza_objetos si el personaje no esta tocado, lo que lanza la escena (p11:A9A8)
L 0xA9A8 lanza_objetos_de_la_escena la rutina de la escena 0xE3A1 - 2 (tabla p11:A9B1)
L 0xAA65 lanza_objeto_11 si no hay proyectil ni objeto en 0xEA60, crea alli uno de clase 0x11
L 0xAADF lanza_objeto_0f un objeto de clase 0x0F en (0x40, 0x78)
L 0xAAE8 lanza_objeto_12 un objeto de clase 0x12 en (0x10, 0x60)
L 0xAAF5 lanza_objeto_17 un objeto de clase 0x17 en (0x20, 0x78)
L 0xAB02 lanza_objeto_18 un objeto de clase 0x18 en (0xF0, 0xF0)
L 0xAB0F lanza_objeto_19 un objeto de clase 0x19 en (0x60, 0xF0)
L 0xAB5D lanza_objeto_0a cada 64 cuadros, sonido y un objeto de clase 0x0A en 0xEA80
L 0xAB76 crea_objeto un objeto de clase C en (E, D) en el primer hueco de los 7 de 0xEA20; acarreo si lo crea
L 0xAB7D crea_objeto_en como p11:AB76 desde IX y B huecos
L 0xABA4 invierte_vy_del_objeto (ix+2/3) = -(ix+2/3)
L 0xABB4 invierte_vx_del_objeto (ix+4/5) = -(ix+4/5)
L 0xABC4 objeto_avanza_xy X y luego Y con su velocidad
L 0xABC7 objeto_avanza_y (ix+6/7) += (ix+2/3)
L 0xABDB objeto_avanza_x (ix+8/9) += (ix+4/5)
L 0xABEF velocidades_del_objeto velocidad X = DE y velocidad Y = HL
L 0xABF3 vy_del_objeto velocidad Y = DE
L 0xABFA vx_del_objeto velocidad X = DE
L 0xAC01 objeto_quieto las dos velocidades a cero
L 0xAC04 vy_del_objeto_a_cero la velocidad Y a cero
L 0xAC09 vx_del_objeto_a_cero la velocidad X a cero
L 0xAC0E borra_objeto los 0x20 bytes de la ficha IX a cero
L 0xAC1C sprites_de_objetos los sprites de los 7 objetos de 0xEA20 en 0xF020 (fotogramas p11:AC85) y el resto escondidos
L 0xAC5A sprites_de_un_objeto las piezas del fotograma (ix+0x0A): [n] y n x [dy][dx][patron][color]
L 0xAD9B objeto_en_fichas el objeto pintado con 3 fichas en la VRAM (p11:ADD4)
L 0xADCC ficha_a_vram A a la VRAM HL
L 0xADE0 objeto_en_fichas_pasos los pasos del objeto en fichas: aparece, cuenta y cae
L 0xAE13 bit_de_columna A = 1 << (X / 16 - 3)
L 0xAE5E borra_objeto_en_fichas borra sus 3 fichas
L 0xAE7D objeto_10 la rutina de la clase 10 de los objetos de 0xEA00 (p10:8CCD)
L 0xAEF6 objeto_11 la rutina de la clase 11 de los objetos de 0xEA00 (p10:8CCD)
L 0xAF36 fotograma_parpadeo_12 fotograma 0x12 o 0x13 segun el bit 1 de A
L 0xAFC7 objeto_13 la rutina de la clase 13 de los objetos de 0xEA00 (p10:8CCD)
L 0xAFDD objeto_siguiente_paso (ix+1) + 1
L 0xB031 fotograma_parpadeo_4 fotograma 4 o 5 segun el bit 3 de A
L 0xB195 objeto_14 la rutina de la clase 14 de los objetos de 0xEA00 (p10:8CCD)
L 0xB226 objeto_15 la rutina de la clase 15 de los objetos de 0xEA00 (p10:8CCD)
L 0xB3F7 cerca_del_personaje si esta abajo, mira la distancia en X al personaje
L 0xB40B mira_los_proyectiles dos proyectiles desde 0xEC39
L 0xB460 distancia_y A = la distancia en Y entre (HL) y el objeto
L 0xB488 objeto_16 la rutina de la clase 16 de los objetos de 0xEA00 (p10:8CCD)
L 0xB536 objeto_17 la rutina de la clase 17 de los objetos de 0xEA00 (p10:8CCD)
L 0xB5B5 alterna_fotograma cada 4 cuadros, el fotograma XOR 1
L 0xB5C4 objeto_18 la rutina de la clase 18 de los objetos de 0xEA00 (p10:8CCD)
L 0xB5FF ficha_bajo_el_objeto A = la ficha del bloque en el centro del objeto
L 0xB621 paso_x_1 H = +16 o -16 segun el bit 0 de A
L 0xB63A paso_x_4 H = +16 o -16 segun el bit 2 de A
L 0xB690 objeto_con_cursores con los cursores, la velocidad del objeto de p11:B6CE y p11:B6DE
L 0xB6BF velocidad_de_tabla DE = la velocidad de p11:B6DE
L 0xB79D objeto_23 la rutina de la clase 23 de los objetos de 0xEA00 (p10:8CCD)
L 0xB800 fotograma_parpadeo_18 fotograma 0x18 o 0x19 cada 4 cuadros
L 0xBA56 parpadeo_de_sprites cada 4 cuadros, el color de 20 sprites desde 0xF033
L 0xBA71 baja_sprites cada (ix+0x1F) cuadros esconde los sprites de 0xF030 y avanza (ix+0x1E)
L 0xBAD3 zona_888 HL = 0x0888 y BC = 0x0470
L 0xBB08 zona_888_b HL = 0x0888 y BC = 0x0470
L 0xBB49 zona_888_c HL = 0x0888 y BC = 0x0470
L 0xBB86 zona_7f8 HL = 0x07F8
L 0xBB89 color_doble 8 bytes de color E en los dos nibbles desde la VRAM HL
L 0xBC5C demo_empieza la demo: sala de partida 2 (0xE338), guion desde el principio (0xE00B) y el personaje en (0x50, 0x60)
L 0xBC86 demo_cuadro un cuadro de la demo (p11:BC92); al acabar el guion, sonido 0x85 y 0xE340 = 0
L 0xBC92 demo_guion el guion p11:BD12: anda hacia cada [Y X] pulsando la tecla, 0xFE n espera, 0xFF acaba; NZ mientras sigue
L 0xBCC3 demo_pulsa la tecla de la demo como si se pulsara (p01:70BE)
L 0xBCFD demo_byte A = el byte 0xE00B del guion
L 0xBD01 demo_byte_c A = el byte C del guion
L 0xBD0B nibble_por_16 A = (A AND 0x0F) * 16
L 0xBD11 solo_ret no hace nada: `ret`
C 0xA00B hl_mas_a: HL = HL + A
C 0xA0CC objeto_fuera: si el objeto sale por la izquierda o por abajo, lo borra y no vuelve a su rutina
C 0xA0CF lee el paso del objeto
C 0xA0D2 despacha: salta a la palabra A de la tabla pegada detras del `call`
C 0xA0DB objeto_fuera: si el objeto sale por la izquierda o por abajo, lo borra y no vuelve a su rutina
C 0xA0DE lee el paso del objeto
C 0xA0E1 despacha: salta a la palabra A de la tabla pegada detras del `call`
C 0xA0EA objeto_fuera: si el objeto sale por la izquierda o por abajo, lo borra y no vuelve a su rutina
C 0xA0ED lee el paso del objeto
C 0xA0F0 despacha: salta a la palabra A de la tabla pegada detras del `call`
C 0xA103 guarda la velocidad X del objeto (alta)
C 0xA106 la cuenta del objeto = 0x03
C 0xA10A el fotograma del objeto = 0x15
C 0xA10E los choques del objeto (bit 0 con el personaje, bit 1 con los proyectiles) = 0x01
C 0xA112 la variable 0x1D del objeto (en los jefes, la accion) = 0x00
C 0xA116 la velocidad Y del objeto = 0x00
C 0xA11A la velocidad X del objeto = 0x80
C 0xA11E la velocidad Y del objeto (alta) = 0xFE
C 0xA128 lee la velocidad Y del objeto
C 0xA12B lee la velocidad Y del objeto (alta)
C 0xA12F guarda la velocidad Y del objeto
C 0xA132 guarda la velocidad Y del objeto (alta)
C 0xA135 objeto_avanza: Y (ix+6/7) += (ix+2/3) y X (ix+8/9) += (ix+4/5)
C 0xA138 lee la Y del objeto
C 0xA144 lee la velocidad Y del objeto
C 0xA147 lee la velocidad Y del objeto (alta)
C 0xA14B guarda la velocidad Y del objeto
C 0xA14E guarda la velocidad Y del objeto (alta)
C 0xA151 objeto_avanza: Y (ix+6/7) += (ix+2/3) y X (ix+8/9) += (ix+4/5)
C 0xA154 lee la X del objeto
C 0xA15B lee la Y del objeto
C 0xA162 borra_objeto: los 0x20 bytes de la ficha IX a cero
C 0xA166 los choques del objeto (bit 0 con el personaje, bit 1 con los proyectiles) = 0x02
C 0xA16A el fotograma del objeto = 0x01
C 0xA16E guarda la variable 0x1D del objeto (en los jefes, la accion)
C 0xA171 guarda la velocidad Y del objeto
C 0xA174 guarda la velocidad Y del objeto (alta)
C 0xA177 guarda la velocidad X del objeto
C 0xA17A la velocidad X del objeto (alta) = 0xF8
C 0xA17F lee el paso del objeto
C 0xA182 despacha: salta a la palabra A de la tabla pegada detras del `call`
C 0xA197 lanza_objeto_17: un objeto de clase 0x17 en (0x20, 0x78)
