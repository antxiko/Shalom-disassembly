# Notas del banco 01

# --- A MANO: comentarios, nombres y bloques ---
C 0x70BE C = lo que habia
C 0x70BF se guarda lo que hay
C 0x70C0 lo que cambia
C 0x70C1 y esta pulsado ahora: lo nuevo
C 0x70C5 registro 15 del PSG: el puerto del joystick 1
C 0x70CC registro 14: lee el joystick
C 0x70D3 pulsado a 1
C 0x70D4 cursores y los dos botones
C 0x70D7 fila 4 del teclado
C 0x70E0 la M al bit 5
C 0x70E3 fila 7 del teclado
C 0x70EB RETURN al bit 6
C 0x70F1 F5 al bit 7
C 0x70F5 fila 8: espacio y cursores
C 0x70FE cursor izquierda al bit 2
C 0x7106 cursor derecha al bit 3 y espacio al bit 4
C 0x710F con el joystick
C 0x7110 juntos
C 0x71B6 a medio camino entre dos bloques?
C 0x71BD los cursores que hay
C 0x71C3 y los del cuadro anterior
C 0x71C8 se guardan para el siguiente
C 0x71C9 ninguno: quieto
C 0x71CC los mismos que antes: sigue igual
C 0x71D0 si se suma uno nuevo, manda el nuevo
C 0x71D6 el primer bit pulsado da la direccion
C 0x71E4 la direccion nueva
C 0x71E8 en el borde: sale de la sala
C 0x71EE el bloque de delante
C 0x71FC 5: se puede pasar
C 0x7200 libre?
C 0x7201 duro: solo se gira
C 0x7213 la direccion del paso
C 0x7219 marca el bloque de destino
C 0x721F a medio camino
C 0x7230 el paso de la direccion
C 0x723B Y + paso
C 0x7243 X + paso
C 0x724A llega a un bloque entero?
C 0x7253 si: ya no esta a medio camino
C 0x7259 la direccion contraria
C 0x726F libera el bloque que deja
C 0x710C cursores arriba y abajo a los bits 0 y 1
C 0x64C8 la cuenta de cuadros
C 0x64CC el estado del juego
C 0x64CF en los estados 0-2
C 0x64D3 se vuelve por p01:6634 (el titulo y la demo miran las teclas)
C 0x64D7 C = el estado y B = el paso
C 0x64DB A = el estado
C 0x64F1 paso 1 (el 0 da la vuelta a B y acaba en p01:650D)
C 0x64F3 un cuadro si y otro no
C 0x64FF paso 2
C 0x6501 espera
C 0x6677 0xE340-0xF080 a cero
C 0x6684 la primera sala: 0x200
C 0x668A el cursor del texto
C 0x6690 el nombre de 0xEB11 por defecto (4 letras y 0xFF)
C 0x66A1 la opcion del titulo
C 0x66A7 la segunda opcion entra con 3
C 0x66D9 la opcion del titulo
C 0x66DC izquierda o derecha?
C 0x66E3 cambia de opcion
C 0x66EC la flecha en una u otra
C 0x66F4 la flecha de la primera opcion
C 0x66FB y la de la segunda
C 0x6054 8 ceros
C 0x6059 los 4 bytes de BC
C 0x6061 el slot propio
C 0x6064 y 20 ceros
C 0x6133 el slot
C 0x6139 compara con DE
C 0x6142 todos iguales: acarreo
C 0x6396 el signo de la X
C 0x6398 la distancia Y / 4, en octavos
C 0x639D la distancia X
C 0x63A3 en valor absoluto
C 0x63A5 y negativa
C 0x648C la letra
C 0x648D 0xFF: acaba, vacio
C 0x6491 una letra: no esta vacio
C 0x66AF el nibble alto
C 0x66B6 un cero a la izquierda no se escribe
C 0x66B8 a partir de la primera cifra, todas
C 0x68AC la casilla del nombre
C 0x68AD el nombre esta lleno?
C 0x68B5 B = la letra
C 0x68BE C = el acento de encima
C 0x68BF la casilla del nombre en pantalla
C 0x68C3 la letra
C 0x68CB y su acento encima
C 0x68D6 la letra al nombre
C 0x68D8 con acento (3 o 4)?
C 0x68DF el acento detras
C 0x69CA L = la Y, H = la X
C 0x69CC la fila
C 0x69D6 la parte alta de la fila
C 0x69D9 desde 0xED00
C 0x6A68 la ficha del borde
C 0x6A6A arriba y abajo
C 0x6A6E la esquina
C 0x6A70 y la otra esquina
C 0x6A73 los lados
C 0x6A76 con la ficha 0x1B
C 0x6A7A el lado izquierdo
C 0x6A7F y el derecho
C 0x6A80 la fila siguiente
C 0x6A95 una menos
C 0x6A97 la letra
C 0x6A98 dos columnas mas alla
C 0x6A9C la siguiente fila (dos filas mas abajo)
C 0x6AA4 una menos
C 0x6AA6 la letra
C 0x6AA7 la siguiente
C 0x6AAC la siguiente fila
C 0x6E47 una letra
C 0x6E4D desde el final
C 0x6E4F hacia atras
C 0x6E51 hasta la ultima letra
C 0x6E56 todo ceros: al principio
C 0x6E6C dos bytes por objeto
C 0x6E73 los bits 1-3 de 0xEB56
C 0x6E7B al objeto 7
C 0x732C el primer bit pulsado
C 0x732D arriba
C 0x7332 abajo
C 0x7336 izquierda
C 0x7339 derecha
C 0x7642 la siguiente direccion
C 0x7643 las cuatro
C 0x764C el bloque en esa direccion
C 0x764D 4: una salida
C 0x7652 la hay: acarreo
C 0x772A la sala 0x22C
C 0x7733 color 4 en la 0x22C
C 0x7737 y en la 0x22D
C 0x773C color 1 en las demas
C 0x7769 Y 0x14, X 0x64
C 0x7770 patron 0xAC, color 1
C 0x777A patron 0xB0, color 0x0B
C 0x7781 12 puntos a la derecha
C 0x7788 patron 0xB4, color 1
C 0x7792 patron 0xB8, color 0x0B
C 0x77FC la cuenta de 0xE3F9
C 0x7801 al acabar
C 0x7802 0xE3F8 a cero
C 0x7E03 9 bytes con 2
C 0x7E0C cada 0x17 bytes
C 0x7E16 tres filas mas
C 0x7E1E 3 bytes con 0x82
C 0x7E27 cada 0x1D bytes
C 0x7E31 seis con 0x82 en 0xE4D0
C 0x7E3E y unos sueltos con 0x84, 0x42 y 0x22

