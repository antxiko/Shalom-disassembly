L 0x4AC2 un_sprite_de_la_lista una entrada de 4 bytes: [banderas][primer patron][RLE] (bit 0: copia volteada de otro)
L 0x4AEC patron_de_sprite HL = 0x1800 + 8 * el byte siguiente de DE
L 0x4AF9 patrones_del_personaje los patrones de p18:65DC[0xEB74 o 0xE3C3] a 0x1860
L 0x4B1A aparece_por_tercios efecto de aparecer en tres pasos (0xE348) sobre la lista de 0xE34C
