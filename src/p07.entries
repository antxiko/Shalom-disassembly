# Puntos de entrada del banco 7 (se ejecuta en 0x8000).
#
# Cada uno lleva la instruccion que lo justifica. Los que ponen "pNN:XXXX"
# vienen de OTRO banco: el trazador de una sola pagina no puede seguirlos,
# porque en esa direccion -segun lo que haya en el registro del mapper- puede
# estar cualquiera de seis bancos. Los que ponen "tabla" salen de una tabla
# del despachador 0x408D, que va pegada detras de su `call` y esta declarada
# como datos en el .nocode: el trazador tampoco puede seguirla.
#
# Los saltos y llamadas DENTRO del propio banco no se ponen aqui: los
# encuentra tools/z80trace.py solo, siguiendo el flujo.
#
# Este fichero lo regenera `make semillas` (tools/bancos.py escribe).
0x8000   # p08:B8E3 call
0x8005   # p08:A35C call
0x800A   # p00:5A74 call
0x8018   # p07:800D entrada 0 de la tabla de 0x8010 (despachador en 0x800D)
0x8019   # p07:800D entrada 1 de la tabla de 0x8010 (despachador en 0x800D)
0x803F   # p07:800D entrada 2 de la tabla de 0x8010 (despachador en 0x800D)
0x8062   # p07:800D entrada 3 de la tabla de 0x8010 (despachador en 0x800D)
0x827A   # p00:42D3 call
0x865C   # p00:42DC call
0x8758   # p00:428F call
0x876C   # p07:875F entrada 0 de la tabla de 0x8762 (despachador en 0x875F)
0x8777   # p07:875F entrada 1 de la tabla de 0x8762 (despachador en 0x875F)
0x8797   # p07:875F entrada 2 de la tabla de 0x8762 (despachador en 0x875F)
0x87BE   # p07:875F entrada 3 de la tabla de 0x8762 (despachador en 0x875F)
0x87D1   # p07:875F entrada 4 de la tabla de 0x8762 (despachador en 0x875F)
0x87EC   # p00:5AB2 call
0x8AD5   # p07:882A entrada 163 de la tabla de 0x882D (despachador en 0x882A)
0x8AD6   # p08:A44D jp
0x8ADE   # p08:B1AE call
0x8AE6   # p08:A3B7 call
0x8AEE   # p08:A3AE call
0x8B01   # p08:A70F jp
0x8B11   # p08:B1F1 call
0x8B14   # p08:B1D4 jp cc
0x8B26   # p08:B1F4 jp
0x8B29   # p08:B65F jp
0x8B40   # p08:AAF7 call
0x8B47   # p08:AFB3 call
0x8B5D   # p08:ABC7 call
0x8B65   # p08:B1C2 call
0x8BAC   # p08:B188 jp cc
0x8BB4   # p08:BCFE jp cc
