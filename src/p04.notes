# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x6000 sonido_41 pide el sonido 0x41
L 0x6005 sonido_50 pide el sonido 0x50
L 0x600A sonido_3a pide el sonido 0x3A
L 0x600F sonido_4a pide el sonido 0x4A
L 0x6014 sonido_4b pide el sonido 0x4B
L 0x6019 comprueba_cuatro_actores 0xE379 = 1 si el byte 0x1B de los actores 1-4 vale 3, 1, 2 y 4; si no, 2
L 0x603F pon_dibujo_6057 sonido 0x1E, 0xE40D = 3 y el dibujo p04:6057 en (0x30, 0x40)
L 0x6090 graficos_del_titulo borde negro, pantalla vacia, 5 graficos de p04:60B5, patrones volteados p05:B255 y sprites p04:60C9
L 0x622B titulo monta el titulo (p04:6234) y el texto p04:606C
L 0x6234 monta_titulo los graficos, el texto p04:605D y el rectangulo de nombres de p05:B5CA
L 0x624F rectangulo_a_vram B filas de C bytes de HL a la VRAM DE (0x20 por fila)
L 0x6266 titulo_cuadro un cuadro del titulo: espera, sonido 0x50 y los sprites que aparecen (0xE3AC, p04:62C3)
L 0x62AE sprites_del_titulo copia a 0xF000 la lista de sprites A de p04:62C3
L 0x631F marco_de_la_escena los RLE p04:633D y p04:6432, el dibujo p04:6443 y 8 x 8 nombres en 0x3818
L 0x6487 fuente_y_colores la fuente en los tres tercios y su color
L 0x648C fuente la fuente en 0x2808 y 0x3000 y su color
L 0x6491 fuente_en_tres_tercios la fuente p04:6F39 en 0x2000, 0x2800 y 0x3000 y lo extra de p04:6F41
L 0x64AC fuente_extra p04:76E9 en 0x2808 y la fuente en 0x3000
L 0x64BB copia_fuente 0x7B0 bytes de la fuente p04:6F39 a la VRAM HL
L 0x64C4 color_de_la_fuente_en_tres_tercios color 0xF0 para la fuente en los tres tercios
L 0x64DC color_de_la_fuente color 0xF0 para la fuente (y 5 y 8 para dos fichas)
L 0x64FE color_f0_de_la_fuente 0x7B0 bytes de color 0xF0 desde HL
L 0x6501 pon_color_f0 llena BC bytes de la VRAM HL con 0xF0
L 0x6506 fuente_en_dos_tercios 0x200 bytes de la fuente en dos tercios y colores a cero
L 0x6527 rotulo_konami el RLE p04:7761 y 6 filas x 21 nombres desde 0x40 en 0x3907
L 0x6555 rotulo_konami_cuadro una columna del rotulo cada cuadro: carga la pantalla 0xE00F (p04:65B8) en 0xED00 y la va pintando (p04:65C4)
L 0x659D pantalla_del_rotulo el RLE de la pantalla A (p04:65B8) a 0xED00
L 0x65AE vram_del_rotulo DE = la direccion de VRAM A de p04:65C4
L 0x65D0 rle_a_ram_con_destino el RLE de HL con su direccion de RAM delante
L 0x65D4 rle_a_ram RLE de HL a la RAM DE: 0 acaba, bit 7 = repite, si no copia n; con 0x80, otra direccion
L 0x65F0 cortinilla_de_la_escena efecto en pasos (0xE348) con la lista de 0xE34C, de dos en dos columnas (p00:4CC2)
L 0x6693 escena_inicial un paso de la escena inicial (0xE350, tabla p04:6699)
L 0x6703 escena_inicial_00 el paso 0 de la escena inicial (0xE350, tabla p04:6699)
L 0x670B escena_inicial_01 el paso 1 de la escena inicial (0xE350, tabla p04:6699)
