# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x81C6 accion_siguiente_escena 0xE3E0 + 1 y su paso 0xE3E1 a cero
L 0x81CE accion_siguiente_paso 0xE3E1 + 1
L 0x81D3 accion_avanza suma las dos velocidades (p02:81E2 y p02:81D6)
L 0x81D6 accion_avanza_y 0xE3E4 (Y, con fraccion) += 0xE3EC
L 0x81E2 accion_avanza_x 0xE3E6 (X, con fraccion) += 0xE3EE
L 0x81EE accion_rebota_y 0xE3EC = -0xE3EC
L 0x81F8 accion_rebota_x 0xE3EE = -0xE3EE
L 0x8202 accion_sin_vida si 0xE3F6 llega a 0: 0xE3F7 = 1 y la escena 6 (Z)
L 0x8214 accion_direccion 0xE3F3 = la direccion pulsada (1, 2, 4, 8), dando preferencia a la nueva
L 0x8254 accion_mueve mueve al personaje de la escena de accion en la direccion A con la velocidad DE y los topes BC; su fotograma (p02:828A)
L 0x8292 accion_un_paso un paso en la direccion A con los topes BC (y BC' en vertical)
L 0x8311 accion_sprites los tres sprites del personaje de la escena de accion (0xE3E5, 0xE3E7) en 0xF000
L 0x83DD accion_sprites_extra dos sprites en 0xF020
L 0x83F7 accion_quita_extra esconde los sprites de 0xF020
L 0x8401 esconde_un_sprite Y = 0xE0 y el resto a cero en el sprite de HL
L 0x840C accion_sprites_arriba tres sprites en la Y 0xA0 alrededor de la X del personaje
L 0x844F cambia_de_sala modo 1: la sala nueva por el borde (vecinas: sala - 0x20, + 0x20, - 1, + 1 de p02:858C), las salas 0x201-0x228 a mano o el salto de 0xE36A
L 0x857D posicion_en_la_sala_nueva Y += C, X += B en el personaje y 0xE3C5 = 0
L 0x859C salas_201_20d las vecinas de las salas 0x202-0x20D (tabla p02:85A4)
L 0x86E4 marca_369 0xE369 = 2 si 0xEB69 no lleva el bit 7
L 0x8714 salas_213_21e las vecinas de las salas 0x213-0x21E (tabla p02:871C)
L 0x88D4 salas_226_227 las vecinas de las salas 0x226 y 0x227
L 0x8906 salta_a_la_sala la sala de 0xE36A; a la 0x201 sin lo que hace falta, la maquina se reinicia (`jp 0`)
L 0x8947 entrada_especial la posicion de entrada en las salas que la tienen a mano (0x201, 0x118, 0xE2, 0x20E, 0x87, 0x152, 0x21F...)
L 0x8C32 salas_al_azar en las salas 0x228-0x22D, la siguiente sale al azar de p02:8C83
L 0x8CF5 actor_de_enfrente 0xE8A6 = el actor que esta delante del personaje (0xFF si no hay); si es una puerta, prepara el salto
L 0x9065 salta_a 0xE36A = HL y 0xE337 = 2: al cambiar de sala se salta a ella
L 0x906E empieza_accion 0xE3A1 = A, 0xE337 = 3 y la escena 0 de la escena de accion
L 0x909B accion_2 la escena de accion 2 en la sala 0x212
L 0x90BC accion_4 la escena de accion 4 en la sala 0x222
L 0x90DD accion_7 la escena de accion 7 en la sala 0x224
L 0x90FF accion_8 la escena de accion 8 en la sala 0x225
L 0x9121 guarda_actor_de_enfrente 0xE8A6 = C
L 0x912E evento un paso del evento 0xE8AA (tabla p02:9135)
L 0x9189 evento_siguiente_paso 0xE8AB + 1
L 0x918E evento_01 el evento 0x01 (0xE8AA): despacha su paso 0xE8AB (tabla p02:9194)
