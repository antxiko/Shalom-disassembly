# Puntos de entrada del banco 14 (se ejecuta en 0xa000).
#
# Cada uno lleva la instruccion que lo justifica. Los que ponen "pNN:XXXX"
# vienen de OTRO banco: el trazador de una sola pagina no puede seguirlos,
# porque en esa direccion -segun lo que haya en el registro del mapper- puede
# estar cualquiera de seis bancos. Los que ponen "tabla" salen de una tabla
# del despachador 0x408D, que va pegada detras de su `call` y esta declarada
# como datos en el .nocode: el trazador tampoco puede seguirla.
#
# Los saltos y llamadas DENTRO del propio banco no se ponen aqui: los
# encuentra tools/z80trace.py solo, siguiendo el flujo.
#
# Este fichero lo regenera `make semillas` (tools/bancos.py escribe).
0xBA95   # p00:4395 call
0xBAAC   # p14:BAA3 entrada 0 de la tabla de 0xBAA4 (jp (hl) en 0xBAA3)
0xBAE0   # p14:BAA3 entrada 1 de la tabla de 0xBAA4 (jp (hl) en 0xBAA3)
0xBB2C   # p14:BAA3 entrada 3 de la tabla de 0xBAA4 (jp (hl) en 0xBAA3)
0xBB51   # p14:BAA3 entrada 2 de la tabla de 0xBAA4 (jp (hl) en 0xBAA3)
0xBBF0   # p00:438C call
0xBC07   # p14:BBFE entrada 0 de la tabla de 0xBBFF (jp (hl) en 0xBBFE)
0xBC5B   # p14:BBFE entrada 1 de la tabla de 0xBBFF (jp (hl) en 0xBBFE)
0xBCB0   # p14:BBFE entrada 2 de la tabla de 0xBBFF (jp (hl) en 0xBBFE)
0xBCEA   # p14:BBFE entrada 3 de la tabla de 0xBBFF (jp (hl) en 0xBBFE)
