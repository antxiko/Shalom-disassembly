L 0x91B0 jefe_2_vencido pone el bit 6 de 0xEB7D
L 0x939E objeto_03 la clase 3 de los objetos de 0xEA00 (p10:8CCD): un paso (ix+1) de la tabla p10:93A4
L 0x93B0 objeto_03_0 la clase 3, paso 0
L 0x93F0 objeto_03_1 la clase 3, paso 1
L 0x9408 objeto_03_2 la clase 3, paso 2
L 0x9420 jefe_3_vencido pone el bit 5 de 0xEB7D y salta a la sala 0x159
L 0x9440 cambia_dibujo_1e cada 5 cuadros, si no esta tocado, un dibujo al azar en (ix+0x1E)
L 0x9461 cambia_dibujo_1f cada 5 cuadros, si no esta tocado, un dibujo al azar en (ix+0x1F)
L 0x9482 al_azar_0_2 A = 0-2 al azar
L 0x9496 borra_dibujo_1e borra el dibujo de (ix+0x1E)
L 0x949A pinta_dibujo_1e pinta el dibujo de (ix+0x1E)
L 0x94A4 borra_dibujo_1f borra el dibujo de (ix+0x1F)
L 0x94A8 pinta_dibujo_1f pinta el dibujo de (ix+0x1F)
L 0x94B3 dibujo_con_mascara [destino] y el dibujo de DE, cada byte AND C
L 0x968C objeto_04 la clase 4 de los objetos de 0xEA00 (p10:8CCD): un paso (ix+1) de la tabla p10:9692
L 0x96A2 objeto_04_0 la clase 4, paso 0
L 0x96E7 bloques_de_fichas B x C bloques de 2 x 2 con las fichas 0x10-0x13
