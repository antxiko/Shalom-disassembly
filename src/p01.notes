# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x6000 otro_cartucho_lee prepara la peticion en 0xE012 (p01:6047) y llama al otro cartucho con C = 0x0A (p01:6073)
L 0x6026 otro_cartucho_graba prepara la peticion en 0xE012 y llama al otro cartucho con C = 0x0B (p01:609D)
L 0x6047 peticion_al_otro_cartucho 0xE012: los 5 bytes de HL, 8 ceros, los 4 de BC, el slot propio y 20 ceros
L 0x6073 llama_otro_cartucho_0a su slot en 0x8000, su banco 4 y `call 0x8000` con C = 0x0A; si falla 0xE38F = 2
L 0x609D llama_otro_cartucho_0b como p01:6073 con C = 0x0B
L 0x60CB busca_otro_cartucho busca en los cuatro slots (y sus subslots) un cartucho con YZ en 0x4010; su slot en 0xF0F7, 0xF0F9 = 1
L 0x60FE busca_en_subslots prueba los cuatro subslots del slot C
L 0x611F es_el_otro_cartucho acarreo si el slot C lleva YZ (p01:6146) en 0x4010
L 0x6131 compara_en_slot compara B bytes de HL en el slot C con DE (RDSLT); acarreo si son iguales
L 0x6148 graficos_27 con 27-28 puestos, el juego de graficos A de la tabla p01:6154
L 0x6151 graficos_27_por_tabla salta a la entrada A de la tabla p01:6154
L 0x6212 nombres_27 12 filas x 16 de la tabla p27:6233[A] a 0xED44
L 0x6309 rumbo_al_personaje el paso (HL, DE) hacia el personaje desde E, D con la velocidad A
L 0x6312 rumbo_desde_ix el paso hacia el personaje desde la ficha IX (+2, +4) con la velocidad A
L 0x6320 rumbo_al_rival el paso hacia 0xE3E5/0xE3E7 con la velocidad A
L 0x6328 rumbo_al_personaje_80 el paso hacia el personaje con la velocidad 0x80
L 0x6369 angulo_al_personaje 0xE359 = el angulo de la posicion D, E al personaje
L 0x6377 angulo_al_rival 0xE359 = el angulo hacia 0xE3E5/0xE3E7
L 0x6381 angulo_al_centro 0xE359 = el angulo hacia (0x40, 0x58)
L 0x6387 angulo 0xE359 = el angulo de 0xE8E0 - E, D (tabla p01:63D5); 0xE354/0xE355 = signos
L 0x63B7 por_velocidad DE = E * 0xE353 / 32
L 0x63C9 multiplica HL = H * E
L 0x648A nombre_vacio Z si los 8 bytes de HL son ceros hasta 0xFF
L 0x6498 nombres_por_defecto si estan vacios, los nombres de 0xEB00 y 0xEB09 por defecto
L 0x64C8 cuadro un cuadro del juego (lo llama la interrupcion): cuenta 0xE003 y despacha el estado 0xE000 (tabla p01:64DF)
L 0x64F1 estado_0 estado 0: el rotulo de Konami (p00:4242) y espera
L 0x651B estado_1 estado 1: el titulo (p00:425D) con el cursor de 0xE335 hasta que se acabe la espera
L 0x6533 estado_2 estado 2: la demo (p09:BC5C, p09:BD11, p09:BC86) hasta que 0xE340 = 0
L 0x654E pon_estado 0xE000 = A y el paso a cero
L 0x655F siguiente_paso 0xE001 + 1
L 0x6564 estado_3 estado 3: empieza la partida (p01:6677) y pasa al 4
L 0x656E estado_4 estado 4: los nombres, la carga de partida y la primera sala, paso a paso
L 0x65CE siguiente_estado_con_espera 0xE004 = A y el siguiente estado
L 0x65D1 siguiente_estado 0xE000 + 1 y el paso a cero
L 0x65F6 estado_5 estado 5: la partida (p00:5A6E); con 0xE336 pasa al 8
L 0x6609 estado_6 estado 6: p01:6487 (4-5-6) hasta 0xE340 bit 7
L 0x6621 estado_7 estado 7: pantalla vacia, 0xE002 sin el bit 6 y al estado 0
L 0x662E estado_8 estado 8: los sprites y p09:6C23
L 0x6677 borra_partida 0xE340-0xF080 a cero, la sala 0x200, nombres y posicion de partida
L 0x66AD cifras_a_vram B cifras BCD de DE (hacia atras) a la VRAM HL, sin ceros a la izquierda
L 0x66D9 cursor_del_titulo izquierda/derecha cambian 0xE335 y pintan la flecha
L 0x6702 primera_sala la sala de partida (o la de 0xE338, p01:67E3) con sus banderas y la entrada
L 0x6760 entra_en_la_sala pone el personaje (p01:7112) y monta la sala (p01:677F)
L 0x677F monta_la_sala musica, fichas, mapa, sprites, actores, marcador y menu de la sala
L 0x67C8 redibuja_la_sala vuelve a montar las fichas y el mapa de la sala
L 0x67E9 pantalla_de_nombres un paso de la pantalla de nombres (0xE351, tabla p01:67EF)
L 0x6801 nombres_primero monta la pantalla de nombres para el primero
L 0x681A nombres_teclas mueve el cursor por la tabla de letras y escribe o borra
L 0x6979 letra_del_nombre HL = el nombre en curso (0xEB00 o 0xEB09) + E
L 0x6988 nombres_borra espera y borra la pantalla
L 0x69A3 nombres_espera espera 0xE352 cuadros
L 0x69AB nombres_segundo monta la pantalla de nombres para el segundo
L 0x69C4 nombres_hecho 0xE333 = 1: acabado
L 0x69CA casilla_de_letras HL = 0xED00 + la casilla de la tabla de letras de HL
L 0x69DD tabla_de_letras la tabla de letras y el marco de la pantalla de nombres en 0xED00
L 0x6A87 vuelca_nombres_1 0x300 de 0xED00 a 0x3800
L 0x6A93 fila_de_iguales C-1 veces A en HL, de dos en dos, filas de 10
L 0x6AA2 fila_seguida C-1 letras seguidas desde A en HL, de dos en dos, filas de 10
L 0x6AA4 fila_seguida_desde como p01:6AA2 sin fijar B
L 0x6ACE menu_de_carga un paso del menu de carga (0xE38E, tabla p01:6AD4)
L 0x6AE0 carga_siguiente 0xE38E + 1
L 0x6AE5 carga_pinta pinta las opciones: con disco (0xFFA7 no es 0xC9) y con el otro cartucho (0xF0F9)
L 0x6B24 carga_elige con disparo, la opcion elegida (p01:6B4D)
L 0x6B51 carga_de_cinta un paso de la carga de cinta (0xE398, tabla p01:6B57)
L 0x6B65 carga_paso 0xE398 + 1
L 0x6B8B lee_la_cinta cabecera de 10 x 0xEA, el nombre de p03:BE03 y 0x3E bytes a 0xEB40; suma de p03:BE3F
L 0x6C04 cinta_mal para el motor y escribe el aviso de error
L 0x6C27 carga_de_disco un paso de la carga de disco (tabla p01:6C2D; p03:BC90)
L 0x6CB7 carga_del_otro_cartucho un paso de la carga del otro cartucho (tabla p01:6CBD)
L 0x6D47 carga_14 un paso de la carga con p14:BBF0 (tabla p01:6D4D)
L 0x6DCE carga_hecha 0xE333 = 1
L 0x6DDC carga_cursor arriba/abajo por las opciones (0xE8A4) con sonido
L 0x6E03 carga_pinta_cursor borra las cuatro flechas y pinta la de la opcion
L 0x6E36 nombres_de_la_partida copia los nombres de la partida cargada (0xEB42, 0xEB4A) a 0xEB00 y 0xEB09
L 0x6E45 copia_nombre 8 bytes de DE a HL y 0xFF tras el ultimo que no es cero
L 0x6E5B objetos_de_la_partida los bits de 0xEB53-0xEB55 al bit 0 de cada objeto de 0xE9D0
L 0x7083 enciende_la_maquina PSG en silencio, VRAM a cero y los registros del VDP
L 0x709F registros_del_vdp los 8 registros del VDP de p01:70B0
L 0x70B8 lee_los_mandos 0xE009 = lo que hay, 0xE008 = lo nuevo
L 0x70BE teclas_nuevas guarda A en (HL) y deja en (HL-1) lo que no estaba
L 0x70C5 mandos joystick 1 y teclado en un byte: bits 0-3 cursores, 4 disparo o espacio, 5 boton 2 o M, 6 RETURN, 7 F5
L 0x7112 personaje_a_la_entrada modo 0 o 7, todo a cero y la posicion de entrada
L 0x7162 mueve_personaje un cuadro del personaje: el modo 0xE3C0 (tabla p01:718E)
L 0x71B6 personaje_anda modos 0 y 1: anda por la cuadricula de 16 x 16 con los cursores
L 0x7289 personaje_modo_2 modo 2: la entrada por arriba
L 0x72BD personaje_baja modo 3: baja 2 puntos por cuadro hasta la Y 0x60
L 0x72DC personaje_modo_4 modo 4: a (0x50, 0x30) mirando arriba, modo 5
L 0x72FD personaje_modo_5 modo 5: espera a que 0xE503 llegue a 0x70
L 0x730C personaje_modo_6 modo 6: anda empujando (bloques 0x50-0x53)
L 0x73C4 borde_del_mundo C = 0xFF si la sala esta en el borde del mapa en la direccion 0xE3C6
L 0x7422 empuja_bloque mira el bloque de delante: si es 0x50-0x53 lo empuja
L 0x74C6 personaje_modo_7 modo 7: sube por la entrada
L 0x74F4 personaje_modo_8 modo 8
L 0x7513 personaje_modo_10 modo 10: empieza a flotar hacia el personaje
L 0x7564 personaje_modo_11 modo 11: gira cada 8 cuadros
L 0x758E personaje_modo_12 modo 12: vuelve a andar
L 0x75B0 personaje_espera modo 13: espera 0xE3D5 cuadros y vuelve al 0
L 0x75BB personaje_modo_15 modo 15: si no hay actor 0, a (0x50, 0x60)
L 0x75D3 personaje_modo_siguiente 0xE3C0 + 1
L 0x75DA personaje_sigue_al_actor modo 16: pegado al actor 0
L 0x7600 personaje_un_paso un paso en la direccion 0xE3C6 (tabla p01:7277)
L 0x7641 busca_salida la primera direccion con un bloque 4 delante; acarreo si la hay
L 0x7654 pegado_al_actor la posicion del actor 0 mas la de p01:766F[direccion]
L 0x7679 marca_al_personaje pone 2 en el bloque del personaje
L 0x7682 salida_especial en la sala 0x18 o sin 0xEB5A bit 5: a los 16 cuadros sale de la sala
L 0x76BE cuenta_de_espera 0xE3C9 + 1; Z al llegar a 16
L 0x76CD sale_de_la_sala al borde: 0xE337 = 1 (o 2 en la sala 0x20E)
L 0x7709 fotograma_del_personaje 0xE3C3 = 2 * (direccion - 1) + el bit 4 de 0xE3C7 y sus sprites
L 0x771F sprites_del_personaje los tres sprites del personaje en 0xF000
L 0x7769 sprites_fijos cuatro sprites fijos en (0x14, 0x64)
L 0x7799 sprites_empujando los sprites del personaje empujando
L 0x77D3 accion un paso del guion de la escena de accion (0xE3E0, tabla p01:77E1; paso 0xE3E1)
L 0x799D rebota_en_los_bordes invierte las dos velocidades, suena y cuenta un rebote (0xE3F1)
L 0x7D80 escena_9_pasos los pasos de la escena 9 segun B
L 0x7F51 no_hace_nada `ret`
