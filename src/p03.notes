L 0xBC90 disco_lee BDOS: abre el fichero de p03:BC85 y lee los 0x3E bytes a 0xE03A
L 0xBCBE bdos_abre BDOS 0x0F (abrir) con el FCB de 0xE035
L 0xBCCE bdos_crea BDOS 0x16 (crear)
L 0xBCDE bdos_cierra BDOS 0x10 (cerrar)
L 0xBCEE prepara_fcb el FCB en DE: unidad 0, el nombre de HL y ceros
L 0xBD05 fcb_registro bloque actual 0, registro de 1 byte y registro aleatorio 0
L 0xBD22 bdos_escribe DTA = 0xC8C0 y 0x3E bytes con BDOS 0x26
L 0xBD30 bdos_lee DTA = 0xE03A y 0x3E bytes con BDOS 0x27
